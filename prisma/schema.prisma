// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Empresa {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  razaoSocial String
  nomeFantasia String?
  cnpj        String   @unique
  email       String?
  telefone    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  usuarios    Usuario[]
  auditorias  Auditoria[]
  clientes    Cliente[]
  produtos    Produto[]
  estoqueMovimentacoes EstoqueMovimentacao[]
  pedidos     Pedido[]
  sequenciasNumeracao SequenciaNumeracao[]
  devolucoes  Devolucao[]
  configuracoes Configuracoes?
  fornecedores Fornecedor[]
  entradasEstoque EntradaEstoque[]
  inventarios Inventario[]

  @@map("empresas")
}

model Usuario {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId          String   @db.Uuid
  nome               String
  email              String   @unique
  senhaHash          String
  precisaTrocarSenha Boolean  @default(false)
  role               String   // ADMIN | SUPERVISOR | OPERADOR
  funcao             String   // VENDAS | ESTOQUE | SEPARACAO | CONFERENCIA | EXPEDICAO | ADMINISTRATIVO
  cargo              String?
  status             String   @default("ativo") // ativo | inativo
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  empresa            Empresa  @relation(fields: [empresaId], references: [id])
  pedidosComoVendedor  Pedido[]       @relation("PedidoVendedor")
  pedidosComoSeparador Pedido[]       @relation("PedidoSeparador")
  pedidoEventos        PedidoEvento[]
  entradasLancadas     EntradaEstoque[] @relation("EntradaLancador")
  inventariosAbertos    Inventario[] @relation("InventarioAbertoPor")
  inventariosResponsavel Inventario[] @relation("InventarioResponsavel")

  @@index([empresaId])
  @@map("usuarios")
}

model Auditoria {
  id              String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  empresaId       String    @db.Uuid
  modulo          String    // varchar de propósito
  acao            String    // varchar de propósito
  entidadeId      String
  descricao       String
  usuarioId       String    @db.Uuid
  usuarioNome     String
  motivo          String?
  camposAlterados Json?     // { campo, valorAnterior, valorNovo }[]
  dataHora        DateTime  @default(now())

  empresa         Empresa   @relation(fields: [empresaId], references: [id])

  @@index([empresaId, dataHora])
  @@index([empresaId, modulo])
  @@map("auditorias")
}

model Endereco {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clienteId   String   @db.Uuid
  logradouro  String
  numero      String
  bairro      String
  cidade      String
  uf          String
  cep         String
  principal   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cliente     Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId])
  @@map("enderecos")
}

model Cliente {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId    String   @db.Uuid
  nome         String
  documento    String
  status       String   @default("ativo") // ativo | bloqueado
  dataCadastro DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  empresa      Empresa   @relation(fields: [empresaId], references: [id])
  enderecos    Endereco[]
  pedidos      Pedido[]

  @@index([empresaId])
  @@unique([empresaId, documento])
  @@map("clientes")
}

model Produto {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId           String   @db.Uuid
  skuInterno          String
  referenciaComercial String?
  codigoBarras        String?
  nome                String
  marca               String
  unidadeMedida       String   // UN | M | KG | CX
  permiteFracionado   Boolean  @default(false)
  custo               Decimal  @db.Decimal(12, 2)
  precoVenda          Decimal  @db.Decimal(12, 2)
  status              String   @default("ativo") // ativo | inativo
  estoqueAtual        Int      @default(0) // fonte de leitura rápida — nunca editável diretamente por formulário, só via EstoqueService (módulo futuro)
  corredor            String?
  categoria           String?
  fornecedor          String?
  estoqueMinimo       Int      @default(10)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id])
  movimentacoes EstoqueMovimentacao[]
  itensPedido ItemPedido[]
  entradaItens EntradaItem[]
  inventarioItens InventarioItem[]

  @@unique([empresaId, skuInterno])
  @@index([empresaId])
  @@index([empresaId, corredor])
  @@map("produtos")
}

model EstoqueMovimentacao {
  id          String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  empresaId   String    @db.Uuid
  produtoId   String    @db.Uuid
  tipo        String    // RESERVA | LIBERACAO_RESERVA | SAIDA | ENTRADA | ENTRADA_DEVOLUCAO | AJUSTE
  quantidade  Decimal   @db.Decimal(12, 3)
  pedidoId    String?   @db.Uuid
  dataHora    DateTime  @default(now())
  usuarioId   String    @db.Uuid
  direcao     String?   // ENTRADA | SAIDA — só usado quando tipo = AJUSTE

  empresa     Empresa   @relation(fields: [empresaId], references: [id])
  produto     Produto   @relation(fields: [produtoId], references: [id])
  pedido      Pedido?   @relation(fields: [pedidoId], references: [id])

  @@index([empresaId, produtoId, dataHora])
  @@index([pedidoId])
  @@map("estoque_movimentacoes")
}

model Pedido {
  id                 String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  empresaId          String   @db.Uuid
  numero             Int
  clienteId          String   @db.Uuid
  vendedorId         String   @db.Uuid
  separadorId        String?  @db.Uuid
  conferenteId       String?  @db.Uuid

  enderecoLogradouro String
  enderecoNumero     String
  enderecoBairro     String
  enderecoCidade     String
  enderecoUf         String
  enderecoCep        String
  enderecoRefId      String?  @db.Uuid // referência opcional ao Endereco cadastrado, só pra navegação/auditoria — os campos acima são o snapshot, fonte de verdade do pedido

  observacao         String?
  transportadora      String?
  status             String   // CRIADO | RESERVADO | EM_SEPARACAO | EM_CONFERENCIA | CONFERIDO | EXPEDIDO | ENTREGUE | CANCELADO
  pendencia          String   @default("NENHUMA") // NENHUMA | RUPTURA_ESTOQUE | DIVERGENCIA_CONFERENCIA
  valorTotal         Decimal  @db.Decimal(12, 2)
  motivoCancelamento String?

  criadoEm           DateTime @default(now())
  statusAlteradoEm   DateTime @updatedAt

  empresa    Empresa        @relation(fields: [empresaId], references: [id])
  cliente    Cliente        @relation(fields: [clienteId], references: [id])
  vendedor   Usuario        @relation("PedidoVendedor", fields: [vendedorId], references: [id])
  separador  Usuario?       @relation("PedidoSeparador", fields: [separadorId], references: [id])
  itens      ItemPedido[]
  eventos    PedidoEvento[]
  movimentacoes EstoqueMovimentacao[]
  devolucoes Devolucao[]
  conferencias Conferencia[]

  @@unique([empresaId, numero])
  @@index([empresaId, status])
  @@map("pedidos")
}

model ItemPedido {
  id                 String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pedidoId           String  @db.Uuid
  produtoId          String  @db.Uuid
  quantidade         Decimal @db.Decimal(12, 3)
  precoUnitario      Decimal @db.Decimal(12, 2)
  desconto           Decimal @default(0) @db.Decimal(5, 2)
  status             String  // PENDENTE | PENDENTE_ESTOQUE | SEPARADO | CANCELADO
  quantidadeSeparada Decimal? @db.Decimal(12, 3) // preenchido só ao finalizar separação (Módulo 12)

  pedido  Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id])
  devolucoes ItemDevolucao[]

  @@index([pedidoId])
  @@map("itens_pedido")
}

model PedidoEvento {
  id        String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  pedidoId  String   @db.Uuid
  tipo      String
  descricao String
  dataHora  DateTime @default(now())
  usuarioId String   @db.Uuid

  pedido  Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([pedidoId, dataHora])
  @@map("pedido_eventos")
}

model SequenciaNumeracao {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId  String @db.Uuid
  tipo       String // PEDIDO | NF | OS | INVENTARIO — varchar por convenção do projeto (mesmo padrão de Produto.status, EstoqueMovimentacao.tipo etc.), não enum nativo
  valorAtual Int    @default(0)

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, tipo])
  @@map("sequencias_numeracao")
}

model Devolucao {
  id                 String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  empresaId          String   @db.Uuid
  pedidoId           String   @db.Uuid
  status             String   // SOLICITADA | CONCLUIDA | CANCELADA
  motivo             String   // avariado | incorreto | defeito | desistencia | excesso | outro
  motivoDescricao    String?  // texto livre, obrigatório só quando motivo = "outro" (validado na action, não no schema)
  solicitadoPorId    String   @db.Uuid
  confirmadoPorId    String?  @db.Uuid
  canceladoPorId     String?  @db.Uuid
  criadoEm           DateTime @default(now())
  statusAlteradoEm   DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id])
  pedido  Pedido  @relation(fields: [pedidoId], references: [id])
  itens   ItemDevolucao[]

  @@index([status])
  @@index([pedidoId])
  @@map("devolucoes")
}

model ItemDevolucao {
  id                    String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  devolucaoId           String   @db.Uuid
  itemPedidoId          String   @db.Uuid
  quantidadeSolicitada  Decimal  @db.Decimal(12, 3)
  quantidadeConfirmada  Decimal? @db.Decimal(12, 3)
  observacaoAjuste      String?

  devolucao  Devolucao  @relation(fields: [devolucaoId], references: [id])
  itemPedido ItemPedido @relation(fields: [itemPedidoId], references: [id])

  @@map("itens_devolucao")
}

model Fornecedor {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId String   @db.Uuid
  nome      String
  contato   String?
  status    String   @default("ativo") // ativo | inativo
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id])
  entradas EntradaEstoque[]

  @@index([empresaId])
  @@map("fornecedores")
}

model EntradaEstoque {
  id                 String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  empresaId          String   @db.Uuid
  fornecedorId       String   @db.Uuid
  numeroNF           String
  serie              String?
  dataEmissao        DateTime
  dataRecebimento    DateTime
  observacao         String?
  lancadoPorId       String   @db.Uuid
  dataHoraLancamento DateTime @default(now())

  empresa    Empresa       @relation(fields: [empresaId], references: [id])
  fornecedor Fornecedor   @relation(fields: [fornecedorId], references: [id])
  lancadoPor Usuario       @relation("EntradaLancador", fields: [lancadoPorId], references: [id])
  itens      EntradaItem[]

  @@unique([empresaId, fornecedorId, numeroNF])
  @@index([empresaId, dataRecebimento])
  @@map("entradas_estoque")
}

model EntradaItem {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entradaId        String  @db.Uuid
  produtoId        String  @db.Uuid
  quantidade       Decimal @db.Decimal(12, 3)
  custoUnitario    Decimal @db.Decimal(12, 2)

  entrada EntradaEstoque @relation(fields: [entradaId], references: [id], onDelete: Cascade)
  produto Produto         @relation(fields: [produtoId], references: [id])

  @@index([entradaId])
  @@map("entrada_itens")
}

model Configuracoes {
  empresaId String @id @db.Uuid

  // regrasOperacionais
  permitirAutoConferencia                 Boolean @default(false)
  permitirAprovacaoExcepcionalDivergencia Boolean @default(false)

  // dadosEmpresa
  razaoSocial  String  @default("")
  nomeFantasia String?
  cnpj         String  @default("")
  email        String?
  telefone     String?
  enderecoLogradouro String?
  enderecoNumero     String?
  enderecoBairro     String?
  enderecoCidade     String?
  enderecoUf         String?
  enderecoCep        String?

  // deposito
  depositoNome        String  @default("")
  depositoLogradouro  String  @default("")
  depositoNumero      String  @default("")
  depositoBairro      String  @default("")
  depositoCidade      String  @default("")
  depositoUf          String  @default("")
  depositoCep         String  @default("")
  depositoResponsavel String?

  // seguranca
  tempoExpiracaoSessaoMinutos Int    @default(30)
  politicaSenhaMinima         String @default("MEDIA") // BASICA | MEDIA | FORTE
  duracaoSenhaTemporariaDias  Int    @default(7)

  updatedAt DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@map("configuracoes")
}


model Conferencia {
  id           String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  pedidoId     String    @db.Uuid
  conferenteId String    @db.Uuid
  iniciadoEm   DateTime  @default(now())
  finalizadoEm DateTime?
  status       String    // EM_ANDAMENTO | CONCLUIDA_SEM_DIVERGENCIA | CONCLUIDA_COM_DIVERGENCIA

  pedido Pedido            @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  itens  ConferenciaItem[]

  @@index([pedidoId])
  @@map("conferencias")
}

model ConferenciaItem {
  id                    String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  conferenciaId         String   @db.Uuid
  itemPedidoId          String   @db.Uuid
  produtoId             String   @db.Uuid
  quantidadeSolicitada  Decimal  @db.Decimal(12, 3)
  quantidadeSeparada    Decimal  @db.Decimal(12, 3)
  quantidadeConferida   Decimal? @db.Decimal(12, 3)
  divergente            Boolean?

  conferencia Conferencia @relation(fields: [conferenciaId], references: [id], onDelete: Cascade)

  @@index([conferenciaId])
  @@map("conferencia_itens")
}

model Inventario {
  id                    String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  empresaId             String   @db.Uuid
  tipoEscopo            String   // CORREDOR | CATEGORIA | FORNECEDOR | LISTA_MANUAL | ESTOQUE_BAIXO | TODOS_PRODUTOS
  descricaoEscopo       String
  recorte               String?  // corredor/categoria/fornecedor específico ou null para escopos que não precisam
  observacao            String?
  status                String   // EM_ANDAMENTO | FINALIZADO
  abertoPorId           String   @db.Uuid
  responsavelContagemId String   @db.Uuid
  abertoEm              DateTime @default(now())
  finalizadoEm          DateTime?
  finalizadoComPendencias Boolean @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  empresa               Empresa  @relation(fields: [empresaId], references: [id])
  abertoPor             Usuario  @relation("InventarioAbertoPor", fields: [abertoPorId], references: [id])
  responsavelContagem   Usuario  @relation("InventarioResponsavel", fields: [responsavelContagemId], references: [id])
  itens                 InventarioItem[]

  @@index([empresaId, status])
  @@index([empresaId, abertoEm])
  @@map("inventarios")
}

model InventarioItem {
  id                    String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  inventarioId          String   @db.Uuid
  produtoId             String   @db.Uuid
  saldoEsperado         Int      // snapshot do estoqueAtual no momento da abertura/recontagem
  ultimaMovimentacaoId  String?  @db.Uuid // ID da EstoqueMovimentacao mais recente no momento do snapshot
  quantidadeContada     Int?     // null = ainda não contado
  status                String   // PENDENTE | CONTADO_OK | DIVERGENTE | NECESSITA_RECONTAGEM | AJUSTADO
  contadoEm             DateTime?
  observacao            String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  inventario            Inventario @relation(fields: [inventarioId], references: [id], onDelete: Cascade)
  produto               Produto    @relation(fields: [produtoId], references: [id])

  @@index([inventarioId])
  @@index([produtoId])
  @@map("inventario_itens")
}