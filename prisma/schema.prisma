// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Empresa {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  razaoSocial String
  nomeFantasia String?
  cnpj        String   @unique
  email       String?
  telefone    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  usuarios    Usuario[]
  auditorias  Auditoria[]

  @@map("empresas")
}

model Usuario {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId          String   @db.Uuid
  nome               String
  email              String   @unique
  senhaHash          String
  precisaTrocarSenha Boolean  @default(false)
  role               String   // ADMIN | SUPERVISOR | OPERADOR
  funcao             String   // VENDAS | ESTOQUE | SEPARACAO | CONFERENCIA | EXPEDICAO | ADMINISTRATIVO
  cargo              String?
  status             String   @default("ativo") // ativo | inativo
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  empresa            Empresa  @relation(fields: [empresaId], references: [id])

  @@index([empresaId])
  @@map("usuarios")
}

model Auditoria {
  id              String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  empresaId       String    @db.Uuid
  modulo          String    // varchar de propósito
  acao            String    // varchar de propósito
  entidadeId      String
  descricao       String
  usuarioId       String    @db.Uuid
  usuarioNome     String
  motivo          String?
  camposAlterados Json?     // { campo, valorAnterior, valorNovo }[]
  dataHora        DateTime  @default(now())

  empresa         Empresa   @relation(fields: [empresaId], references: [id])

  @@index([empresaId, dataHora])
  @@index([empresaId, modulo])
  @@map("auditorias")
}